* Simulation-only sources and load for the named production nets.
.param VIN_USB=5 VBOOST_EN=5 VBOOST_CV=1.65 RLOAD_HV=100k
.param TVIN_RISE=100u TENABLE=1m
VUSB VCC 0 PULSE(0 {VIN_USB} 0 {TVIN_RISE} {TVIN_RISE} 100m 200m)
VEN MC_BOOST_EN 0 PULSE(0 {VBOOST_EN} {TENABLE} 1u 1u 100m 200m)
VCV MC_BOOST_CV 0 {VBOOST_CV}
RLOAD LINE 0 {RLOAD_HV}
